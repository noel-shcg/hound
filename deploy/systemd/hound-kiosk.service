[Unit]
Description=Hound Dashboard Kiosk Mode
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=hound
Group=hound
WorkingDirectory=/opt/hound
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/hound/.Xauthority"
ExecStart=/opt/hound/deploy/kiosk/hound-kiosk.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
