[Unit]
Description=Hound Dashboard Application
After=docker.service network.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hound
ExecStart=/usr/bin/docker-compose -f /opt/hound/docker-compose.yml up -d
ExecStop=/usr/bin/docker-compose -f /opt/hound/docker-compose.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
