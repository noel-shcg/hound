# Hound Environment Configuration
# Copy this file to .env and adjust values as needed

# Secret key for session signing (generate a secure random string)
HOUND_SECRET_KEY=change-this-to-a-secure-random-string

# Database
HOUND_DATABASE_PATH=/data/hound.db

# Persistent storage directories
HOUND_PHOTO_DIR=/data/photos
HOUND_BACKUP_DIR=/data/backups

# Timezone
HOUND_TIMEZONE=Europe/London

# Weather settings
HOUND_WEATHER_REFRESH_INTERVAL=900  # 15 minutes in seconds

# Bus settings
HOUND_BUS_REFRESH_INTERVAL=60  # 1 minute in seconds

# Screensaver settings
HOUND_SCREENSAVER_TIMEOUT=60  # 1 minute in seconds
HOUND_PHOTO_ROTATION_INTERVAL=10  # 10 seconds in seconds
HOUND_DIMMING_START=22:00  # 10 PM
HOUND_DIMMING_END=07:00  # 7 AM

# Theme settings
HOUND_DAY_THEME_START=07:00
HOUND_EVENING_THEME_START=19:00

# Backup settings
HOUND_BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily (cron format)
HOUND_BACKUP_RETENTION_DAYS=30

# Update settings
HOUND_UPDATE_CHANNEL=stable
HOUND_AUTO_UPDATE_ENABLED=true
HOUND_UPDATE_CHECK_INTERVAL=86400  # 24 hours in seconds

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_DASHBOARD_URL=http://localhost:3000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
